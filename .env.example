# Settings for docker-compose.yml (HSM Server behind the bundled Caddy image).
#
#   cp .env.example .env
#   Edit HSM_DOMAIN and provide the required DNS token before running docker compose up -d.
#
# HSM_DOMAIN and HSM_CERTIFICATE are always required. DNS values are required only for
# letsencrypt-dns. This template defaults to Cloudflare DNS-01, so set CF_API_TOKEN before
# startup, or deliberately choose another certificate mode. Keep `.env` private: `docker compose config` expands and prints its values.

# Bare DNS name or IP address. Do not include https://, a port, or a path.
HSM_DOMAIN=hsm.example.com

# Certificate mode:
#
#   letsencrypt       Backward-compatible alias for letsencrypt-http.
#   letsencrypt-http  Trusted Let's Encrypt certificate through HTTP-01/TLS-ALPN. The public DNS
#                     name must point here and ports 80/443 must be reachable. If issuance fails,
#                     HTTPS fails closed; no other certificate is selected automatically.
#   letsencrypt-dns   Trusted Let's Encrypt certificate through DNS. Set HSM_DNS_PROVIDER and the
#                     matching token below. Port 80 is not required.
#   self-signed       Caddy internal certificate. Clients must trust its CA or allow untrusted TLS.
#   custom            PEM files supplied by the administrator. Put the full certificate chain in
#                     CaddyCertificates/cert.pem and its private key in CaddyCertificates/key.pem.
#                     Mounts are read-only; renew externally, then run `docker compose restart caddy`.
#
# To expose HSM's existing PFX directly without Caddy, use docker-compose.direct.yml instead.
HSM_CERTIFICATE=letsencrypt-dns

# DNS challenge provider (only for HSM_CERTIFICATE=letsencrypt-dns): cloudflare or dynv6.
# Cloudflare is the documented default. Its scoped token needs Zone:DNS:Edit and Zone:Zone:Read.
HSM_DNS_PROVIDER=cloudflare

# Set exactly the token used by the selected provider. Do not commit the populated .env file.
CF_API_TOKEN=
DYNV6_API_TOKEN=

# Log storage (compose 'logs' profile): VictoriaLogs for searching HSM logs; the vlagent
# service tails the app's JSON log file and ships it there with durable delivery (the log
# files on disk remain the source of truth). Storage runs while 'logs' stays below; the log
# UI and query API stay OFF until you set real credentials (VL_UI_* below). Disable
# everything by removing 'logs'.
COMPOSE_PROFILES=logs

# Basic-auth credentials for the VictoriaLogs UI (https://<HSM_DOMAIN>/select/vmui) and query
# API (/select/logsql). They are commented out on purpose: while both stay unset, Caddy serves
# no log routes at all, so a fresh install does not expose the logs. To enable them, uncomment
# BOTH lines and set a long random password (at least 12 characters; the container refuses the
# example placeholder 'change-me' and anything shorter). Anyone who knows the password can read
# the logs. These credentials are separate from HSM user accounts.
# If the password contains '$', single-quote the whole value (VL_UI_PASSWORD='Xq$7mR...') or
# avoid '$': Compose interpolates $VAR inside .env values and would silently change it.
#VL_UI_USER=hsm-logs
#VL_UI_PASSWORD=

# How long VictoriaLogs keeps log entries. Minimum is 1d; VictoriaLogs duration syntax
# (e.g. 30d, 4w). This time-based retention is independent of the disk cap below.
VL_RETENTION_PERIOD=30d

# Absolute disk cap for VictoriaLogs: the oldest per-day partitions are dropped when it is exceeded; raise it if you keep more than ~10GiB of logs.
VL_RETENTION_MAX_DISK=10GiB

# Structured JSON logging in the app (the JSON archive file that vlagent ships to
# VictoriaLogs). Keep 'true' while the 'logs' profile is enabled. Compose defaults it to
# 'false' when the variable is missing: an .env from before log storage never starts writing
# the archive, so enabling the pipeline after an upgrade means adding this pair of settings.
HSM_STRUCTURED_LOGS=true

