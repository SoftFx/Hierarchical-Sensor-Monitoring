# Settings for docker-compose.yml (HSM Server behind Caddy).
#
#   cp .env.example .env      # the file must be named .env and lie next to docker-compose.yml
#   (edit the two values below)
#   docker compose up -d
#
# Both values are required: without them every `docker compose` command stops with an error.
# To change a value later, edit .env and run `docker compose up -d` again: Caddy is recreated
# with the new value. Data and settings of HSM are not affected.

# ---------------------------------------------------------------------------------------------
# HSM_DOMAIN - the address clients use: a bare DNS name or IP address.
#   No https://, no port, no trailing slash. Examples: hsm.example.com, 10.0.0.5
#   Collectors and agents connect to https://<HSM_DOMAIN>:44330, the web UI is
#   https://<HSM_DOMAIN> or https://<HSM_DOMAIN>:44333.
# ---------------------------------------------------------------------------------------------
HSM_DOMAIN=hsm.example.com

# ---------------------------------------------------------------------------------------------
# HSM_CERTIFICATE - which certificate clients get. One of:
#
#   letsencrypt   Trusted certificate from Let's Encrypt, obtained at start and renewed
#                 automatically about 30 days before it expires.
#                 Needs: HSM_DOMAIN is a public DNS name pointing to this server, and ports
#                 80/443 are reachable from the internet.
#                 If Let's Encrypt cannot issue it, there is NO certificate and HTTPS fails;
#                 the reason is in `docker logs hsm-caddy`. Nothing switches by itself: fix the
#                 cause, or switch to self-signed. If a renewal fails, the current certificate
#                 keeps working until it expires while Caddy retries.
#
#   self-signed   Caddy's own certificate. Always works. Browsers show a warning, and
#                 collectors/agents need "allow untrusted certificate".
#                 Use it for an IP address, an internal network, or while Let's Encrypt is
#                 unavailable.
#
# To run HSM without Caddy at all (HSM's own certificate, as before), do not use this file:
#   docker compose down && docker compose -f docker-compose.direct.yml up -d
# Details: https://github.com/SoftFx/Hierarchical-Sensor-Monitoring/wiki/Installation
# ---------------------------------------------------------------------------------------------
HSM_CERTIFICATE=letsencrypt
