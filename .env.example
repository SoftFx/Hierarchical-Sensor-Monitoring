# Settings for docker-compose.yml (HSM Server behind the bundled Caddy image).
#
#   cp .env.example .env
#   Edit HSM_DOMAIN and provide the required DNS token before running docker compose up -d.
#
# HSM_DOMAIN and HSM_CERTIFICATE are always required. DNS values are required only for
# letsencrypt-dns. This template defaults to Cloudflare DNS-01, so set CF_API_TOKEN before
# startup, or deliberately choose another certificate mode. Keep `.env` private: `docker compose config` expands and prints its values.

# Bare DNS name or IP address. Do not include https://, a port, or a path.
HSM_DOMAIN=hsm.example.com

# Certificate mode:
#
#   letsencrypt       Backward-compatible alias for letsencrypt-http.
#   letsencrypt-http  Trusted Let's Encrypt certificate through HTTP-01/TLS-ALPN. The public DNS
#                     name must point here and ports 80/443 must be reachable. If issuance fails,
#                     HTTPS fails closed; no other certificate is selected automatically.
#   letsencrypt-dns   Trusted Let's Encrypt certificate through DNS. Set HSM_DNS_PROVIDER and the
#                     matching token below. Port 80 is not required.
#   self-signed       Caddy internal certificate. Clients must trust its CA or allow untrusted TLS.
#   custom            PEM files supplied by the administrator. Put the full certificate chain in
#                     CaddyCertificates/cert.pem and its private key in CaddyCertificates/key.pem.
#                     Mounts are read-only; renew externally, then run `docker compose restart caddy`.
#
# To expose HSM's existing PFX directly without Caddy, use docker-compose.direct.yml instead.
HSM_CERTIFICATE=letsencrypt-dns

# DNS challenge provider (only for HSM_CERTIFICATE=letsencrypt-dns): cloudflare or dynv6.
# Cloudflare is the documented default. Its scoped token needs Zone:DNS:Edit and Zone:Zone:Read.
HSM_DNS_PROVIDER=cloudflare

# Set exactly the token used by the selected provider. Do not commit the populated .env file.
CF_API_TOKEN=
DYNV6_API_TOKEN=
