{
  "name": "hsm-collector",
  "version": "0.13.0",
  "description": "Native C++ HSM DataCollector — stable C ABI core + header-only RAII C++ wrapper.",
  "homepage": "https://github.com/SoftFx/Hierarchical-Sensor-Monitoring",
  "supports": "!uwp",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "http": {
      "description": "libcurl HTTP transport and WebSocket connection (Schannel on Windows, OpenSSL elsewhere)",
      "dependencies": [
        {
          "name": "curl",
          "default-features": false,
          "features": ["ssl", "websockets"],
          "version>=": "8.14.0"
        },
        "nlohmann-json"
      ]
    }
  }
}
