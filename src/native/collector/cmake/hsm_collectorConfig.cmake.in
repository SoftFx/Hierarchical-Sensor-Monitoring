@PACKAGE_INIT@

# find_package(hsm_collector) config (#1100). Re-resolves the public link dependencies of
# hsm_collector_core, then pulls in the exported targets:
#   hsm_collector::hsm_collector_core  (static core + C ABI)
#   hsm_collector::hsm_collector_cpp   (header-only C++ RAII wrapper; links the core)

include(CMakeFindDependencyMacro)

find_dependency(Threads)

# CURL is needed only when the library was built with the HTTP transport (HSM_COLLECTOR_HTTP).
# It is PRIVATE-linked into the static core, but a static archive still propagates private link
# requirements (as $<LINK_ONLY:>), so a consumer must be able to resolve it. Baked in at configure time.
if(@HSM_COLLECTOR_HTTP@)
    find_dependency(CURL)
endif()

# zstd and zlib are needed only when the library was built with table sensors (HSM_COLLECTOR_TABLES),
# private to the static core like CURL. zstd is found the way the build found it: its package config,
# or pkg-config (libzstd.pc) where the build had no config.
if(@HSM_COLLECTOR_TABLES@)
    if(@HSM_COLLECTOR_ZSTD_PKGCONFIG@)
        find_dependency(PkgConfig)
        if(NOT TARGET PkgConfig::HSM_ZSTD)
            pkg_check_modules(HSM_ZSTD REQUIRED IMPORTED_TARGET GLOBAL libzstd)
        endif()
    else()
        find_dependency(zstd CONFIG)
    endif()
    find_dependency(ZLIB)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/hsm_collectorTargets.cmake")

check_required_components(hsm_collector)
