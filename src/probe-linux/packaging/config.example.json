{
  "hsm": {
    "address": "https://hsm.example.invalid",
    "port": 44330,
    "accessKeyFile": "access-key",
    "computerName": "linux-host",
    "module": "LinuxProbe",
    "packageCollectPeriodSec": 15,
    "requestTimeoutSec": 30
  },
  "logging": {
    "directory": "/var/log/hsm-linux-probe",
    "level": "info"
  },
  "probe": {
    "hostSensors": {
      "enabled": true,
      "cpuTemperature": true
    },
    "disks": {
      "enabled": true,
      "exclude": [],
      "writeSpeed": true
    },
    "docker": {
      "enabled": true,
      "socket": "/var/run/docker.sock",
      "composeOnly": true,
      "samplePeriodSec": 5,
      "oomLatchHours": 24
    }
  },
  "shutdownTimeoutSec": 10
}
