{
  "hsm": {
    "address": "https://hsm.example.invalid",
    "port": 44330,
    "accessKeyFile": "access-key",
    "packageCollectPeriodSec": 15,
    "requestTimeoutSec": 30
  },
  "logging": {
    "directory": "/var/log/hsm-linux-probe",
    "level": "info"
  },
  "probe": {
    "hostSensors": {
      "enabled": true,
      "cpuTemperature": true
    },
    "disks": {
      "enabled": true,
      "exclude": [],
      "writeSpeed": true
    },
    "docker": {
      "enabled": true,
      "socket": "/var/run/docker.sock",
      "composeOnly": true,
      "samplePeriodSec": 60,
      "oomLatchHours": 24,
      "exclude": []
    }
  },
  "topCpu": {
    "enabled": false,
    "periodMs": 60000,
    "minPercent": 1.0,
    "count": 10
  },
  "shutdownTimeoutSec": 10
}
