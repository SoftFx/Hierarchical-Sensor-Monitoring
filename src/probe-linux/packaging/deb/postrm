#!/bin/sh
set -e
# The Docker socket drop-in postinst wrote (docker-access.sh install). Removed here rather than by
# the script, which is already gone by the time postrm runs. Kept across upgrades: the new
# postinst rewrites it. Likewise the top-CPU drop-in (ProtectProc=default) the server bundle's
# install.sh writes when "Report top processes by CPU" is on (#1479); upgrades keep it.
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    rm -f /etc/systemd/system/hsm-linux-probe.service.d/docker.conf
    rm -f /etc/systemd/system/hsm-linux-probe.service.d/top-cpu.conf
    rmdir /etc/systemd/system/hsm-linux-probe.service.d 2>/dev/null || true
    # The top disk I/O helper's enablement link (#1547), when prerm could not disable it (no
    # running systemd): its unit file is gone with the package.
    rm -f /etc/systemd/system/multi-user.target.wants/hsm-linux-probe-io.service
    # Its last snapshot, kept across stops (RuntimeDirectoryPreserve=yes): every process's pid, name
    # and I/O counters must not outlive the package until the next reboot.
    rm -rf /run/hsm-linux-probe-io
fi
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi
if [ "$1" = "purge" ]; then
    rm -rf /var/lib/hsm-linux-probe /var/log/hsm-linux-probe
    # The config postinst seeded (no longer a conffile, so dpkg does not purge it) and any
    # leftovers of the conffile era; the access key placed by install.sh is the operator's.
    rm -f /etc/hsm-linux-probe/config.json /etc/hsm-linux-probe/config.json.dpkg-dist \
        /etc/hsm-linux-probe/config.json.dpkg-old /etc/hsm-linux-probe/config.json.dpkg-new
    rmdir /etc/hsm-linux-probe 2>/dev/null || true
fi
exit 0
