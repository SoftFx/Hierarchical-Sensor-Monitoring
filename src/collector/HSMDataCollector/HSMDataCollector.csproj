<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>HSMDataCollector.HSMDataCollector</PackageId>
    <TargetFrameworks>net8.0;net472</TargetFrameworks>
    <OutputType>Library</OutputType>
    <AssemblyVersion>5.0.0</AssemblyVersion>
    <AssemblyFileVersion>5.0.0</AssemblyFileVersion>
    <ProductVersion>5.0.0</ProductVersion>
    <Version>5.0.0-preview</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Authors>HSM team</Authors>
    <Company>Soft-FX</Company>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright © 2025</Copyright>
    <IsPackable>true</IsPackable>
    <Description>Collection with default sensors and http client for work with HSM server</Description>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AutoGenerateBindingRedirects>False</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HSMDataCollector.Tests" />
    <InternalsVisibleTo Include="HSMDataCollector.IntegrationTests" />
    <InternalsVisibleTo Include="HSMDataCollector.CrashTests.Host" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="collector.nlog.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="NLog" Version="5.3.4" />
    <PackageReference Include="Polly.Core" Version="8.4.2" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <PackageReference Include="System.Threading.Channels" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net472' ">
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
  <ItemGroup>
    <!-- PrivateAssets="all" keeps HSMSensorDataObjects out of the .nuspec dependencies;
         its DLL is bundled into this package instead (see IncludeSensorDataObjectsInPackage). -->
    <ProjectReference Include="..\..\api\HSMSensorDataObjects\HSMSensorDataObjects.csproj" PrivateAssets="all" />
    <!-- The table block format (ADR-0021), bundled the same way. Its own packages are kept out
         of the .nuspec by PrivateAssets="all", so the collector references them directly below. -->
    <ProjectReference Include="..\..\api\HSMTableBlocks\HSMTableBlocks.csproj" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- The dependencies of the bundled HSMTableBlocks.dll: zstd (MIT, a managed port, no native
         binaries) and CRC-32 (MIT, Microsoft). The versions are those HSMTableBlocks builds with. -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
    <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
  </ItemGroup>
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeSensorDataObjectsInPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <Target Name="IncludeSensorDataObjectsInPackage">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)HSMSensorDataObjects.dll" />
      <BuildOutputInPackage Include="$(OutputPath)HSMTableBlocks.dll" />
    </ItemGroup>
  </Target>
</Project>
