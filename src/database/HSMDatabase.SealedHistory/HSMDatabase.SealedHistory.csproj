<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <!-- The zstd frame checks call ZstdSharp.Unsafe.Methods over a pinned span. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- MIT, pure managed port of zstd (no native binaries). -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\server\HSMCommon\HSMCommon.csproj" />
    <!-- The batch codec of table sensors (#1850) takes the column types and the null map bit order of the block format. -->
    <ProjectReference Include="..\..\api\HSMTableBlocks\HSMTableBlocks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HSMDatabase.SealedHistory.Tests" />
    <InternalsVisibleTo Include="SealedHistoryBench" />
  </ItemGroup>

</Project>
