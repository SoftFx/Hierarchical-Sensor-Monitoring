<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="c:\temp\internal-nlog.txt">

	<!--
    Enable ASP.NET Core layout renderers for NLog.
    Required for ASP.NET Core specific logging features.
  -->
	<extensions>
		<add assembly="NLog.Web.AspNetCore"/>
		<!-- ${hsm-redacted}: sink-level hsm_pat_ credential redaction (HSMServer.Logging.TokenRedactionLayoutRenderer) -->
		<add assembly="HSMServer"/>
	</extensions>

	<!--
		Define logging targets (output destinations).
		All targets are configured for asynchronous writing.
		Archived files under Logs/Archives are stored uncompressed: NLog 6 removed
		enableArchiveFileCompression from FileTarget (it moved to the separate
		NLog.Targets.GZipFile package), so that attribute is gone from every target below.
		The three legacy targets keep their historical .zip archive names; the jsonfile
		target archives as .json, matching its uncompressed NDJSON content.

		Retention contract (the reason every fileName below is STATIC, not ${shortdate}-dated):
		NLog only moves a file into Logs/Archives and only applies maxArchiveFiles cleanup
		to files it archives from a static active name. With a dated fileName each day just
		opens a new file and yesterday's dated file is abandoned in Logs/ forever — no
		archive move, no cleanup; on long-lived installs that grew Logs/ unbounded (dev,
		2026-10: 49 GiB, incl. a two-day event flood of 22 GiB). Every target therefore
		writes a static file, rotates it daily AND at 100 MB (DateAndSequence archives),
		and caps Logs/Archives at 60 archive files (~6 GiB per target worst case).
	-->
	<targets async="true">
		<!--
      Error log file target:
      - Logs only error level messages
      - Daily and 100MB archiving into Logs/Archives
      - Keeps 60 archive files
      - Includes thread ID, event ID, log level, logger name, message and exception details
    -->
		<target xsi:type="File"
			name="errorfile"
			fileName="${basedir}/Logs/HSM-error-log.txt"
			layout="${longdate}|${pad:padding=3:fixedLength=true:inner=${threadid}}|${event-properties:item=EventId_Id}|${uppercase:${level}}|${logger}| ${hsm-redacted:inner=${message} ${exception:format=tostring}}|trace: ${aspnet-TraceIdentifier}"
			archiveFileName="${basedir}/Logs/Archives/HSM-error-log-{#}.zip"
			archiveNumbering="DateAndSequence"
			archiveEvery="Day"
			archiveAboveSize="104857600"
			archiveDateFormat="yyyy-MM-dd"
			maxArchiveFiles="60"
			enableFileDelete="true"/>

		<!--
      General log file target:
      - Logs all messages (Trace level and above)
      - Archives when file reaches 100MB or daily
      - Keeps 60 archive files
      - Includes timestamp, thread ID, log level, logger name, message and exception
    -->
		<target xsi:type="File"
			name="allfile"
			fileName="${basedir}/Logs/HSM-all-log.txt"
			layout="${longdate}|${pad:padding=3:fixedLength=true:inner=${threadid}}|${uppercase:${level}}|${logger}| ${hsm-redacted:inner=${message} ${exception:format=tostring}}|trace: ${aspnet-TraceIdentifier}"
			archiveFileName="${basedir}/Logs/Archives/HSM-all-log-{#}.zip"
			archiveNumbering="DateAndSequence"
			archiveEvery="Day"
			archiveAboveSize="104857600"
			archiveDateFormat="yyyy-MM-dd"
			maxArchiveFiles="60"
			enableFileDelete="true"
         />

		<!--
      ASP.NET specific log file target:
      - Logs ASP.NET related messages (Trace level and above)
      - Includes additional ASP.NET context info (URL, MVC action)
      - Same archiving strategy as general log
    -->
		<target xsi:type="File"
		name="aspfile"
		fileName="${basedir}/Logs/ASP-all-log.txt"
		layout="${longdate}|${pad:padding=3:fixedLength=true:inner=${threadid}}|${event-properties:item=EventId_Id}|${uppercase:${level}}|${logger}| ${hsm-redacted:inner=${message} ${exception:format=tostring}}|url: ${hsm-redacted:inner=${aspnet-request-url}}|action: ${aspnet-mvc-action}|trace: ${aspnet-TraceIdentifier}"
		archiveFileName="${basedir}/Logs/Archives/ASP-all-log-{#}.zip"
		archiveNumbering="DateAndSequence"
		archiveEvery="Day"
		archiveAboveSize="104857600"
		archiveDateFormat="yyyy-MM-dd"
		maxArchiveFiles="60"
		enableFileDelete="true"
    />

		<!--
      Structured JSON log file target (docker-compose log storage, #1470):
      - Single-line JSON per event: JsonLayout escapes newlines, so one event = one line
			- Written only when HSM_STRUCTURED_LOGS=true (set in .env for the compose 'logs'
			  profile; the compose default is false); other deployments never write it
			- Uses VictoriaLogs' reserved field names (_time, _msg), so the vlagent file
			  collector maps _time/_msg directly (via the explicit msgField/timeField flags
			  in docker-compose.yml) and keeps every other attribute as a log field
			- It is the durable archive and the single shipping source: vlagent tails this
			  file and ships it to VictoriaLogs with durable delivery (checkpoints + on-disk
			  buffer; see aicontext/architecture/docker.md). Edge case: old files are archived
			  away into Logs/Archives and never re-read, so a vlagent outage spanning a
			  rotation can lose the rotated file's tail from VictoriaLogs — it stays in the
			  archive file. Rotation is daily AND at 100MB, so a flood archives mid-day too;
			  that is the accepted trade-off for capping the disk (the 2026-10 dev flood
			  wrote 22 GiB in two days and filled the disk).
			- The active name is STATIC and must keep matching vlagent's
			  -fileCollector.glob=HSM-structured-log-*.json (docker-compose.yml): dated
			  names would defeat archiving (see the retention contract above), and a name
			  outside the glob would make vlagent stop shipping. NlogConfigTests pins this.
			- Same credential redaction as the text targets (${hsm-redacted} inside _msg)
			- Daily and 100MB archiving into Logs/Archives as .json (uncompressed NDJSON)
		-->
		<target xsi:type="File"
			name="jsonfile"
			fileName="${basedir}/Logs/HSM-structured-log-current.json"
			archiveFileName="${basedir}/Logs/Archives/HSM-structured-log-{#}.json"
			archiveNumbering="DateAndSequence"
			archiveEvery="Day"
			archiveAboveSize="104857600"
			archiveDateFormat="yyyy-MM-dd"
			maxArchiveFiles="60"
			enableFileDelete="true">
			<layout xsi:type="JsonLayout">
				<!-- UTC round-trip ISO 8601: unambiguous regardless of the container's TZ,
                so _time survives a deployment with TZ set (VictoriaLogs parses RFC 3339) -->
				<attribute name="_time" layout="${date:universalTime=true:format=o}" />
				<attribute name="level" layout="${uppercase:${level}}" />
				<attribute name="logger" layout="${logger}" />
				<attribute name="thread" layout="${threadid}" />
				<attribute name="traceId" layout="${aspnet-TraceIdentifier}" />
				<!-- The space separating message and exception lives inside ${onexception},
            so _msg carries no trailing space when the event has no exception. -->
				<attribute name="_msg" layout="${hsm-redacted:inner=${message}${onexception:inner= ${exception:format=tostring}}}" />
			</layout>
		</target>
	</targets>

	<!-- 
    Define logging rules that route messages to appropriate targets.
    Filters can be applied based on build configuration (Debug/Release).
  -->
	<rules>
		<!-- Route all errors to errorfile target -->
		<logger name="*" minlevel="Error" writeTo="errorfile"/>

		<!--
      Framework Warn+ must still reach the JSON store even though the
      Microsoft.AspNetCore* rule below is final for that namespace: Kestrel
      connection errors, unhandled-exception middleware, DataProtection key
      warnings. Info request noise is dropped by the final rule exactly as in
      the text targets. App (non-framework) events never match this rule, and
      framework events never survive past the final rule, so nothing is
      written twice.
    -->
		<logger name="Microsoft.AspNetCore*" minlevel="Warn" writeTo="jsonfile">
			<filters defaultAction="Ignore">
				<!-- cached=true: the env value cannot change without a restart, so cache the lookup (same gate in the app rule below) -->
				<when condition="'${environment:HSM_STRUCTURED_LOGS:cached=true}' == 'true'" action="Log" />
			</filters>
		</logger>

		<!--
      Route ASP.NET framework logs to aspfile target in Debug configuration only.
      Includes Trace level and above messages.
    -->
		<logger name="Microsoft.AspNetCore*" minlevel="Trace" writeTo="aspfile">
			<filters defaultAction="LogFinal">
				<when condition="'${buildConfiguration}' == 'Release'" action="IgnoreFinal" />
			</filters>
		</logger>

		<!--
      Route application Info and above to the structured JSON target, only when
      HSM_STRUCTURED_LOGS=true (docker-compose log storage; mirrors the
      buildConfiguration filter style above so other deployments are unaffected).
      Must stay BELOW the Microsoft.AspNetCore* rule: that rule is final for
      framework logs (IgnoreFinal in Release), which is what keeps per-request
      framework Info noise out of the text targets - and out of the JSON file,
      exactly like the text targets. Only application events reach the write
      here; framework Warn+ is captured separately by the Microsoft.AspNetCore*
      jsonfile rule above the final rule. Above this rule, every HTTP request
      would add 5-8 Info lines to the JSON file (and to VictoriaLogs).
    -->
		<logger name="*" minlevel="Info" writeTo="jsonfile">
			<filters defaultAction="Ignore">
				<when condition="'${environment:HSM_STRUCTURED_LOGS:cached=true}' == 'true'" action="Log" />
			</filters>
		</logger>

		<!-- 
      Route all Trace and Debug messages to allfile target in Debug configuration only.
      These messages will be ignored in Release builds.
    -->
		<logger name="*" minlevel="Trace" maxlevel="Debug" writeTo="allfile">
			<filters defaultAction="Log">
				<when condition="'${buildConfiguration}' == 'Release'" action="IgnoreFinal" />
			</filters>
		</logger>

		<!-- 
      Route all Info level messages to allfile target.
      (Currently no filters applied to Info messages)
    -->
		<logger name="*" minlevel="Info" maxlevel="Info" writeTo="allfile">
			<!-- Writes only specified classes log messages -->
			<!--<filters defaultAction="Log">
        <when condition="logger == '${infrastructureLogger}'" action="LogFinal" />
        <when condition="'${buildConfiguration}' == 'Release'" action="IgnoreFinal" />
      </filters>-->
		</logger>

		<!-- Route all Warning messages to allfile target -->
		<logger name="*" minlevel="Warn" writeTo="allfile"/>
	</rules>
</nlog>
