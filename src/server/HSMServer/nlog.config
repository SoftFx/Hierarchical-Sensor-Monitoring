<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="c:\temp\internal-nlog.txt">

	<!--
    Enable ASP.NET Core layout renderers for NLog.
    Required for ASP.NET Core specific logging features.
  -->
	<extensions>
		<add assembly="NLog.Web.AspNetCore"/>
		<!-- ${hsm-redacted}: sink-level hsm_pat_ credential redaction (HSMServer.Logging.TokenRedactionLayoutRenderer) -->
		<add assembly="HSMServer"/>
	</extensions>

	<!--
		Define logging targets (output destinations).
		All targets are configured for asynchronous writing.
		Archived files under Logs/Archives are stored uncompressed: NLog 6 removed
		enableArchiveFileCompression from FileTarget (it moved to the separate
		NLog.Targets.GZipFile package), so that attribute is gone from every target below.
		All targets keep their historical .zip archive names.

		Retention contract (the reason every fileName below is STATIC, not ${shortdate}-dated):
		NLog only moves a file into Logs/Archives and only applies maxArchiveFiles cleanup
		to files it archives from a static active name. With a dated fileName each day just
		opens a new file and yesterday's dated file is abandoned in Logs/ forever — no
		archive move, no cleanup; on long-lived installs that grew Logs/ unbounded (dev,
		2026-10: 49 GiB, incl. a two-day event flood of 22 GiB). Every target therefore
		writes a static file, rotates it daily AND at 100 MB (DateAndSequence archives),
		and caps Logs/Archives at 60 archive files (~6 GiB per target worst case).
	-->
	<targets async="true">
		<!--
      Error log file target:
      - Logs only error level messages
      - Daily and 100MB archiving into Logs/Archives
      - Keeps 60 archive files
      - Includes thread ID, event ID, log level, logger name, message and exception details
    -->
		<target xsi:type="File"
			name="errorfile"
			fileName="${basedir}/Logs/HSM-error-log.txt"
			layout="${longdate}|${pad:padding=3:fixedLength=true:inner=${threadid}}|${event-properties:item=EventId_Id}|${uppercase:${level}}|${logger}| ${hsm-redacted:inner=${message} ${exception:format=tostring}}|trace: ${aspnet-TraceIdentifier}"
			archiveFileName="${basedir}/Logs/Archives/HSM-error-log-{#}.zip"
			archiveNumbering="DateAndSequence"
			archiveEvery="Day"
			archiveAboveSize="104857600"
			archiveDateFormat="yyyy-MM-dd"
			maxArchiveFiles="60"
			enableFileDelete="true"/>

		<!--
      General log file target:
      - Logs all messages (Trace level and above)
      - Archives when file reaches 100MB or daily
      - Keeps 60 archive files
      - Includes timestamp, thread ID, log level, logger name, message and exception
    -->
		<target xsi:type="File"
			name="allfile"
			fileName="${basedir}/Logs/HSM-all-log.txt"
			layout="${longdate}|${pad:padding=3:fixedLength=true:inner=${threadid}}|${uppercase:${level}}|${logger}| ${hsm-redacted:inner=${message} ${exception:format=tostring}}|trace: ${aspnet-TraceIdentifier}"
			archiveFileName="${basedir}/Logs/Archives/HSM-all-log-{#}.zip"
			archiveNumbering="DateAndSequence"
			archiveEvery="Day"
			archiveAboveSize="104857600"
			archiveDateFormat="yyyy-MM-dd"
			maxArchiveFiles="60"
			enableFileDelete="true"
         />

		<!--
      ASP.NET specific log file target:
      - Logs ASP.NET related messages (Trace level and above)
      - Includes additional ASP.NET context info (URL, MVC action)
      - Same archiving strategy as general log
    -->
		<target xsi:type="File"
		name="aspfile"
		fileName="${basedir}/Logs/ASP-all-log.txt"
		layout="${longdate}|${pad:padding=3:fixedLength=true:inner=${threadid}}|${event-properties:item=EventId_Id}|${uppercase:${level}}|${logger}| ${hsm-redacted:inner=${message} ${exception:format=tostring}}|url: ${hsm-redacted:inner=${aspnet-request-url}}|action: ${aspnet-mvc-action}|trace: ${aspnet-TraceIdentifier}"
		archiveFileName="${basedir}/Logs/Archives/ASP-all-log-{#}.zip"
		archiveNumbering="DateAndSequence"
		archiveEvery="Day"
		archiveAboveSize="104857600"
		archiveDateFormat="yyyy-MM-dd"
		maxArchiveFiles="60"
		enableFileDelete="true"
    />

	</targets>

	<!-- 
    Define logging rules that route messages to appropriate targets.
    Filters can be applied based on build configuration (Debug/Release).
  -->
	<rules>
		<!--
      Route all errors to errorfile target.
      #1613: an expected MCP tool failure is a client mistake the SDK relays to
      the caller as isError=true, and ALSO logs at ERROR as "\"{tool}\" threw an
      unhandled exception" from the ModelContextProtocol.Server.McpServer
      logger. Two arms: our tools signal validation/not-found/conflict outcomes
      by throwing McpException, and the SDK's argument binder rejects the
      caller's arguments with an ArgumentException ("missing a value for the
      required parameter ..." - the 3.41.8 MCP test pass logged both). A
      retrying agent would flood the operator error log with entries needing no
      operator attention, hiding real errors. The filter skips exactly those
      entries for this rule only - they still reach HSM-all-log.txt through the
      Warn+ rule below. Genuinely unexpected exceptions (any other type, or
      either type from any other logger) keep landing here. See ADR-0016.
    -->
		<logger name="*" minlevel="Error" writeTo="errorfile">
			<filters defaultAction="Log">
				<when condition="('${exception:format=Type}' == 'ModelContextProtocol.McpException' or starts-with('${exception:format=Type}', 'System.Argument')) and logger == 'ModelContextProtocol.Server.McpServer'" action="Ignore"/>
			</filters>
		</logger>

		<!--
      Route ASP.NET framework logs to aspfile target in Debug configuration only.
      Includes Trace level and above messages.
    -->
		<logger name="Microsoft.AspNetCore*" minlevel="Trace" writeTo="aspfile">
			<filters defaultAction="LogFinal">
				<when condition="'${buildConfiguration}' == 'Release'" action="IgnoreFinal" />
			</filters>
		</logger>

		<!-- 
      Route all Trace and Debug messages to allfile target in Debug configuration only.
      These messages will be ignored in Release builds.
    -->
		<logger name="*" minlevel="Trace" maxlevel="Debug" writeTo="allfile">
			<filters defaultAction="Log">
				<when condition="'${buildConfiguration}' == 'Release'" action="IgnoreFinal" />
			</filters>
		</logger>

		<!-- 
      Route all Info level messages to allfile target.
      (Currently no filters applied to Info messages)
    -->
		<logger name="*" minlevel="Info" maxlevel="Info" writeTo="allfile">
			<!-- Writes only specified classes log messages -->
			<!--<filters defaultAction="Log">
        <when condition="logger == '${infrastructureLogger}'" action="LogFinal" />
        <when condition="'${buildConfiguration}' == 'Release'" action="IgnoreFinal" />
      </filters>-->
		</logger>

		<!-- Route all Warning messages to allfile target -->
		<logger name="*" minlevel="Warn" writeTo="allfile"/>
	</rules>
</nlog>
