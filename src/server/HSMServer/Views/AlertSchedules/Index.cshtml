@using HSMServer.Constants
@using HSMServer.Controllers
@using HSMServer.Core.Model
@using HSMServer.Model.AlertSchedule
@using HSMServer.Model.Authentication

@model List<AlertScheduleViewModel>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    // #1409: schedule MUTATION is admin-only ([AuthorizeIsAdmin] on
    // SavePartial/Remove), so the Add/Edit/Remove controls render for
    // admins only — non-admins keep the read-only page instead of buttons
    // that answer 401 (same pattern as Views/Dashboards/Index.cshtml).
    var userIsAdmin = Context.User is User user && user.IsAdmin;
}

<div class="container">
    <div class="row w-100 justify-content-center">
        <div class="m-2">
            @if (TempData[TextConstants.TempDataErrorText] != null)
            {
                <div class="alert alert-danger">@TempData[TextConstants.TempDataErrorText].ToString()</div>
            }
            <div class="d-flex justify-content-between my-2">
                <h5>Alert Schedules</h5>
                <div class='d-flex col-md-auto'>
                    @if (userIsAdmin)
                    {
                        <button id="addScheduleBtn" class="btn btn-link p-0">
                            <i class="fa-solid fa-plus"></i> Add Schedule
                        </button>
                    }
                </div>
            </div>

            <div id="alertSchedulesTableContainer">
                @await Html.PartialAsync("_AlertSchedulesTable", Model)
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_AlertScheduleModal")

<script>
    var scheduleUrls = {
        newPartial: '@Url.Action("NewPartial", "AlertSchedules")',
        editPartial: '@Url.Action("EditPartial", "AlertSchedules")',
        savePartial: '@Url.Action("SavePartial", "AlertSchedules")',
        getTable: '@Url.Action("GetAlertSchedulesTable", "AlertSchedules")'
    };

    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
      return new bootstrap.Tooltip(tooltipTriggerEl)
    })

</script>

