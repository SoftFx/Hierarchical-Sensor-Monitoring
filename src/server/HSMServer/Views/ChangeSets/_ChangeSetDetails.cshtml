@using HSMServer.Model.ManagementApi.ChangeSets

@model ChangeSetDetailsDto

<div class="modal-header">
    <h5 class="modal-title">Change set @Model.Summary.Id.Substring(0, 8)…</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body" id="changeSetDetailsBody" style="max-height: 70vh; overflow-y: auto;">
    <p>
        <strong>Author:</strong> @Model.Summary.Author
        &nbsp; <strong>Created (UTC):</strong> @Model.Summary.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")
        &nbsp; <strong>Status:</strong> @Model.Summary.Status
    </p>

    @foreach (var entry in Model.Entries)
    {
        <div class="card mb-2">
            <div class="card-header d-flex justify-content-between">
                <span>@entry.Kind @entry.Operation</span>
                <span class="text-muted">@entry.Path</span>
            </div>
            <div class="card-body">
                @if (entry.Restored)
                {
                    <div class="text-muted mb-1">Restored by change set @entry.RestoredBy?.Substring(0, 8)…</div>
                }
                @if (entry.Before.Count > 0 || entry.After.Count > 0)
                {
                    <div class="row">
                        <div class="col-6">
                            <div class="fw-bold">Before</div>
                            @foreach (var image in entry.Before)
                            {
                                <pre class="mb-1 small">@image</pre>
                            }
                        </div>
                        <div class="col-6">
                            <div class="fw-bold">After</div>
                            @foreach (var image in entry.After)
                            {
                                <pre class="mb-1 small">@image</pre>
                            }
                        </div>
                    </div>
                }
                @if (entry.BeforeTemplate is not null || entry.AfterTemplate is not null)
                {
                    <div class="row">
                        <div class="col-6">
                            <div class="fw-bold">Before</div>
                            <pre class="mb-1 small">@entry.BeforeTemplate</pre>
                        </div>
                        <div class="col-6">
                            <div class="fw-bold">After</div>
                            <pre class="mb-1 small">@entry.AfterTemplate</pre>
                        </div>
                    </div>
                }
                @if (entry.BeforeSchedule is not null || entry.AfterSchedule is not null)
                {
                    <div class="row">
                        <div class="col-6">
                            <div class="fw-bold">Before</div>
                            <pre class="mb-1 small">@entry.BeforeSchedule</pre>
                        </div>
                        <div class="col-6">
                            <div class="fw-bold">After</div>
                            <pre class="mb-1 small">@entry.AfterSchedule</pre>
                        </div>
                    </div>
                }
                @if (entry.Fanout is { Count: > 0 })
                {
                    <div class="fw-bold mt-1">Fan-out (@entry.Fanout.Count sensors)</div>
                    @foreach (var image in entry.Fanout)
                    {
                        <details class="mb-1">
                            <summary class="text-muted">@image.Path</summary>
                            <div class="row">
                                <div class="col-6">
                                    <div class="fw-bold">Before</div>
                                    @foreach (var image2 in image.BeforePolicies.Concat(image.BeforeTtlPolicies))
                                    {
                                        <pre class="mb-1 small">@image2</pre>
                                    }
                                </div>
                                <div class="col-6">
                                    <div class="fw-bold">After</div>
                                    @foreach (var image2 in image.AfterPolicies.Concat(image.AfterTtlPolicies))
                                    {
                                        <pre class="mb-1 small">@image2</pre>
                                    }
                                </div>
                            </div>
                        </details>
                    }
                }
            </div>
        </div>
    }
</div>
<div class="modal-footer">
    @if (Model.Summary.Status != "rolledBack")
    {
        <button type="button" class="btn btn-outline-danger" id="changeSetRollbackFromDetails" data-change-set-id="@Model.Summary.Id">Rollback</button>
    }
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>
