@using HSMServer.Model.Authentication
@using HSMServer.Model.ManagementApi.ChangeSets

@model List<ChangeSetSummaryDto>

@{
    var userIsAdmin = Context.User is User user && user.IsAdmin;
}

<table class="table table-striped" id="changeSetsTable">
    <thead>
        <tr>
            <th scope="col">Created (UTC)</th>
            <th scope="col">Author</th>
            <th scope="col">Status</th>
            <th scope="col">Entities</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="5" class="text-muted">No change sets yet.</td></tr>
        }
        @foreach (var item in Model)
        {
            <tr data-change-set-id="@item.Id">
                <td>@item.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@item.Author</td>
                <td>
                    @switch (item.Status)
                    {
                        case "rolledBack":<span class="badge bg-secondary">rolled back</span>
                            break;
                        case "partial":<span class="badge bg-warning text-dark">partial</span>
                            break;
                        default:<span class="badge bg-success">applied</span>
                            break;
                    }
                    <span class="text-muted">@item.RestoredEntryCount/@item.EntryCount restored</span>
                </td>
                <td>
                    @foreach (var path in item.Entities.Take(3))
                    {
                        <div class="text-truncate" style="max-width: 320px;" title="@path">@path</div>
                    }
                    @if (item.Entities.Count > 3)
                    {
                        <div class="text-muted">+@(item.Entities.Count - 3) more</div>
                    }
                </td>
                <td>
                    <button class="btn btn-link p-0 change-set-details-btn" data-change-set-id="@item.Id">Details</button>
                    @if (userIsAdmin && item.Status != "rolledBack")
                    {
                        <button class="btn btn-link p-0 text-danger change-set-rollback-btn"
                                data-change-set-id="@item.Id">Rollback</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
