@using HSMServer.Extensions
@using HSMServer.Notifications.Chats

<div class="modal fade" tabindex="-1" role="dialog" id="slackHelp_modal">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fab fa-slack"></i> How to create a Slack incoming webhook</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" onclick="hideSlackHelpModal()" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <p>A Slack incoming webhook is a private URL that lets HSM send alert messages to one selected Slack channel. First create this URL in Slack, then paste it into the Webhook URL field in HSM.</p>
                <ol>
                    @foreach (var step in ChatSetupGuide.Slack)
                    {
                        <li>@step.ToHtml()</li>
                    }
                </ol>
                <p class="mb-0"><strong>Important:</strong> one webhook is connected to one Slack channel. To send alerts to multiple channels, create one chat per channel.</p>
            </div>
        </div>
    </div>
</div>


<script>
    function showSlackHelpModal() {
        $(`#slackHelp_modal`).modal({
            backdrop: 'static'
        });
        $(`#slackHelp_modal`).modal('show');
    }

    function hideSlackHelpModal() {
        $(`#slackHelp_modal`).modal('hide');
    }
</script>
