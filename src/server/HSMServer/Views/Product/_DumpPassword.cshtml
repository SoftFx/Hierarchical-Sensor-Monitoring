@using HSMServer.Model.LargeFiles
@using HSMServer.Model.Authentication
@using Microsoft.Extensions.DependencyInjection

@model Guid

@{
    // Resolved here rather than injected: the archive side of large files is registered by AddLargeFileArchives only
    // once its services are in place (#1885); until then the section is not shown. The section model never holds a
    // password value: values reach the browser only in the JSON answers of the POST actions below.
    var service = Context.RequestServices.GetService<DumpPasswordPageService>();
    var panel = service?.GetSection(User as User, Model);
    const string timeFormat = "yyyy-MM-dd HH:mm 'UTC'";
}

@if (panel is not null)
{
    <div class="my-1" id="dumpPassword_div">
        <h5 class="mt-2">Dump password</h5>

        <p class="mb-1">
            @if (panel.HasPassword)
            {
                <span class="badge bg-success">Set</span>
            }
            else
            {
                <span class="badge bg-warning text-dark">Not set</span>
                <span class="text-muted small ms-1">While there is no password, the product's large files are kept and cannot be downloaded.</span>
            }
        </p>

        <div class="text-muted small">
            <p class="mb-1">
                Every large file of the product (a dump, for example) is given out only as a zip archive encrypted with this password
                (AES-256). The archive opens in 7-Zip or WinRAR; the archiver built into Windows usually cannot open it.
            </p>
            <p class="mb-1">
                The password does not hide the name of the file inside the archive, its sizes or its time.
            </p>
            <p class="mb-2">
                A new password re-encrypts the kept archives in the background. Until an archive is re-encrypted it opens with the
                password it was made with; the download shows which version that is.
            </p>
        </div>

        @if (panel.CanManage)
        {
            @if (panel.Versions.Count > 0)
            {
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th scope="col">Version</th>
                            <th scope="col">Set</th>
                            <th scope="col">By</th>
                            <th scope="col">State</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var version in panel.Versions)
                        {
                            <tr>
                                <td>@version.Version</td>
                                <td>@version.SetUtc.ToString(timeFormat)</td>
                                <td class="text-break">@version.SetBy</td>
                                <td>
                                    @if (version.IsCurrent)
                                    {
                                        <span>current</span>
                                    }
                                    else if (version.KeptUntilUtc is { } keptUntil)
                                    {
                                        <span>replaced, kept until @keptUntil.ToString(timeFormat)</span>
                                    }
                                    else
                                    {
                                        <span>replaced, archives are being re-encrypted</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <button id="dumpPasswordShowButton" type="button" class="btn btn-secondary btn-sm mb-2">
                    <i class="fa-solid fa-eye"></i> Show
                </button>
                <div id="dumpPasswordValues_div" class="mb-2"></div>
            }

            <div class="input-group mb-1" style="max-width: 640px">
                <input id="dumpPasswordInput" type="text" class="form-control font-monospace" autocomplete="off" spellcheck="false"
                       maxlength="@panel.MaxLength" placeholder="At least @panel.MinTypedLength printable ASCII characters" />
                <button id="dumpPasswordGenerateButton" type="button" class="btn btn-secondary">Generate</button>
                <button id="dumpPasswordSaveButton" type="button" class="btn btn-primary">Save</button>
            </div>
            <div id="dumpPasswordMessage" class="small mb-2"></div>

            <script>
                (function () {
                    const productId = '@panel.ProductId';
                    const showUrl = "@Html.Raw(Url.Action("Show", "DumpPassword"))";
                    const generateUrl = "@Html.Raw(Url.Action("Generate", "DumpPassword"))";
                    const setUrl = "@Html.Raw(Url.Action("Set", "DumpPassword"))";
                    let generatedValue = null;

                    function post(url, body) {
                        return fetch(url, {
                            method: 'POST',
                            cache: 'no-store',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').first().val()
                            },
                            body: JSON.stringify(body)
                        });
                    }

                    function showMessage(text, isError) {
                        const message = document.getElementById('dumpPasswordMessage');
                        message.textContent = text;
                        message.className = 'small mb-2 ' + (isError ? 'text-danger' : 'text-success');
                    }

                    const showButton = document.getElementById('dumpPasswordShowButton');
                    if (showButton) {
                        showButton.addEventListener('click', async function () {
                            const target = document.getElementById('dumpPasswordValues_div');
                            target.replaceChildren();

                            const response = await post(showUrl, { productId: productId });
                            if (!response.ok) {
                                showMessage('The passwords could not be shown (' + response.status + ').', true);
                                return;
                            }

                            const data = await response.json();
                            const list = document.createElement('ul');
                            list.className = 'list-unstyled font-monospace small';

                            for (const version of data.versions) {
                                const item = document.createElement('li');
                                let state = version.isCurrent ? 'current' : 'replaced';
                                if (!version.isCurrent && version.keptUntilUtc)
                                    state = 'replaced, kept until ' + version.keptUntilUtc.substring(0, 16).replace('T', ' ') + ' UTC';
                                item.textContent = 'v' + version.version + ' (' + state + '): ' + version.password;
                                list.appendChild(item);
                            }

                            target.appendChild(list);
                        });
                    }

                    const input = document.getElementById('dumpPasswordInput');

                    document.getElementById('dumpPasswordGenerateButton').addEventListener('click', async function () {
                        const response = await post(generateUrl, { productId: productId });
                        if (!response.ok) {
                            showMessage('A password could not be generated (' + response.status + ').', true);
                            return;
                        }

                        const data = await response.json();
                        generatedValue = data.password;
                        input.value = data.password;
                        showMessage('Generated, not saved yet: copy it somewhere safe, then press Save.', false);
                    });

                    document.getElementById('dumpPasswordSaveButton').addEventListener('click', async function () {
                        const response = await post(setUrl, {
                            productId: productId,
                            password: input.value,
                            generated: generatedValue !== null && input.value === generatedValue
                        });

                        if (response.ok) {
                            const data = await response.json();
                            input.value = '';
                            generatedValue = null;
                            showMessage(data.message, false);
                            setTimeout(function () { document.location.reload(); }, 1500);
                            return;
                        }

                        let text = 'The password was not saved (' + response.status + ').';
                        if (response.status === 400) {
                            const data = await response.json();
                            text = data.error;
                        }
                        showMessage(text, true);
                    });
                })();
            </script>
        }
    </div>
}
