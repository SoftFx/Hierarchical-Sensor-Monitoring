@using HSMServer.Constants
@using HSMServer.Helpers
@using HSMServer.Model.Profile
@model ProfilePageViewModel

@{
    ViewData["Title"] = "Profile";

    var userName = Model.UserName?.Trim() ?? string.Empty;
    var userInitials = AvatarHelper.InitialsOf(userName);
    var avatarColor = AvatarHelper.ColorOf(Model.UserId);
    var quotaFull = Model.QuotaUsed >= Model.QuotaMax;
}

<script>
    var createTokenUrl = "@Html.Raw(Url.Action(ViewConstants.CreateTokenAction, ViewConstants.ProfileController))";
    var renameTokenUrl = "@Html.Raw(Url.Action(ViewConstants.RenameTokenAction, ViewConstants.ProfileController))";
    var rotateTokenUrl = "@Html.Raw(Url.Action(ViewConstants.RotateTokenAction, ViewConstants.ProfileController))";
    var revokeTokenUrl = "@Html.Raw(Url.Action(ViewConstants.RevokeTokenAction, ViewConstants.ProfileController))";
    var tokensEnabled = @Json.Serialize(Model.TokensEnabled);
    var generationStateHealthy = @Json.Serialize(Model.GenerationStateHealthy);
</script>

<style>
    .profile-container { max-width: 960px; margin: 0 auto; padding: 2rem 1rem; }
    .profile-avatar { width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 500; }
    .product-badge { padding: 0.125rem 0.5rem; font-size: 0.75rem; border: 1px solid #d1d5db; border-radius: 9999px; background-color: #f5f5f5; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; max-width: 150px; }
    .product-badge.manager { border-color: #a7f3d0; background-color: #ecfdf5; }
    .admin-badge { padding: 0.125rem 0.5rem; font-size: 0.75rem; border: 1px solid #d1d5db; border-radius: 9999px; }
    .token-row { padding: 0.75rem 1rem; border-bottom: 1px solid #e5e7eb; }
    .token-row:last-child { border-bottom: none; }
    .token-row:hover { background-color: #f9fafb; }
    .token-row.dead { opacity: 0.55; }
    .access-badge { padding: 0.125rem 0.5rem; font-size: 0.75rem; border-radius: 9999px; border: 1px solid #d1d5db; white-space: nowrap; }
    .access-badge.read-write { color: #1d4ed8; border-color: #bfdbfe; background-color: #eff6ff; }
    .access-badge.read-only { color: #6b7280; background-color: #f3f4f6; }
    .action-btn { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; padding: 0; background: none; border: 1px solid #d1d5db; border-radius: 0.5rem; cursor: pointer; color: #6b7280; font-size: 0.875rem; }
    .action-btn:hover { background-color: #f9fafb; }
    .action-btn.danger { color: #ef4444; }
    .action-btn.danger:hover { background-color: #fef2f2; border-color: #fca5a5; }
    .list-header { display: flex; gap: 1rem; padding: 0.75rem 1rem; background-color: #f9fafb; border-bottom: 1px solid #e5e7eb; font-size: 0.875rem; color: #6b7280; border-radius: 0.5rem 0.5rem 0 0; }
    .token-list { border: 1px solid #e5e7eb; border-radius: 0.5rem; overflow: hidden; }
    .token-secret { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.8125rem; word-break: break-all; background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 0.5rem; padding: 0.75rem; user-select: all; }
    .status-badge { padding: 0.125rem 0.5rem; font-size: 0.75rem; border-radius: 9999px; border: 1px solid #d1d5db; }
    .status-badge.active { color: #15803d; border-color: #a7f3d0; background-color: #ecfdf5; }
    .status-badge.revoked { color: #6b7280; background-color: #f3f4f6; }
    .status-badge.invalidated { color: #6d28d9; border-color: #ddd6fe; background-color: #f5f3ff; }
    .modal-error { display: none; }
</style>

<div class="profile-container">
    <div class="d-flex align-items-center gap-3 mb-2">
        <div class="profile-avatar" style="background-color: @avatarColor;">@userInitials</div>
        <div>
            <h1 class="h4 fw-semibold mb-0">@userName</h1>
            <div class="d-flex flex-wrap gap-1 mt-1">
                @if (Model.IsAdmin)
                {
                    <span class="admin-badge">Admin</span>
                }
                else
                {
                    foreach (var product in Model.Products)
                    {
                        <span class="product-badge @(product.IsManager ? "manager" : "")" title="@(product.IsManager ? "Product manager" : "Product viewer")">@product.Name</span>
                    }
                }
            </div>
        </div>
    </div>

    <hr class="my-4">

    <div class="d-flex align-items-center justify-content-between mb-2">
        <h2 class="h5 fw-semibold mb-0">API tokens</h2>
        @if (Model.TokensEnabled)
        {
            <div class="d-flex align-items-center gap-2">
                <span class="text-secondary" id="quotaBadge">@Model.QuotaUsed / @Model.QuotaMax</span>
                <button id="createTokenButton" type="button" class="btn d-flex align-items-center gap-1"
                        style="background-color: #16a34a; color: #fff; border-color: #16a34a;"
                @(quotaFull ? "disabled" : "") title="@(quotaFull ? "Revoke an unused token to free a slot" : "")">
                    <i class="fas fa-plus"></i> Create token
                </button>
            </div>
        }
    </div>

    <div class="text-secondary mb-2" style="font-size: 0.875rem;">
        A token acts with your own rights — everything you can see and change, everywhere you can. A read-only token can only read. Tokens do not expire; revoke them when no longer needed.
    </div>

    @if (!Model.TokensEnabled)
    {
        if (!Model.GenerationStateHealthy)
        {
            <div class="alert alert-warning py-2">
                Token state is unreliable after a storage problem; lifecycle operations are unavailable. Contact an administrator.
            </div>
        }
        else
        {
            <div class="alert alert-info py-2">
                API tokens are disabled by the server configuration; existing tokens no longer authenticate. Listing and revocation remain available.
            </div>
        }
    }

    <div class="token-list">
        <div class="list-header">
            <div style="flex: 2;">Name</div>
            <div style="flex: 1;">Access</div>
            <div style="flex: 1;">Created</div>
            <div style="flex: 1;">Last used</div>
            <div style="width: 84px;">Status</div>
            <div style="width: 124px; text-align: right;">Actions</div>
        </div>

        @foreach (var token in Model.Tokens)
        {
            var dead = token.Status != "active";
            <div class="token-row d-flex align-items-center @(dead ? "dead" : "")"
                 data-entity-id="@token.EntityId"
                 data-status="@token.Status"
                 data-name="@token.Name">
                <div style="flex: 2; min-width: 0;">
                    <div class="fw-medium text-truncate">@token.Name</div>
                </div>
                <div style="flex: 1;">
                    <span class="access-badge @(token.ReadOnly ? "read-only" : "read-write")" title="@(token.ReadOnly ? "Read-only: every write operation is denied" : "Read and write, mirroring your rights")">@(token.ReadOnly ? "Read-only" : "Read / write")</span>
                </div>
                <div style="flex: 1;" class="text-secondary" data-timestamp="@token.CreatedAtUnixMs">—</div>
                <div style="flex: 1;" class="text-secondary" data-timestamp="@(token.LastUsedAtUnixMs)">@(token.LastUsedAtUnixMs is null ? "never" : "—")</div>
                <div style="width: 84px;"><span class="status-badge @token.Status">@token.Status</span></div>
                <div style="width: 124px; text-align: right;" class="d-flex justify-content-end gap-1">
                    @if (!dead && Model.TokensEnabled)
                    {
                        <button type="button" class="action-btn rename-button" title="Rename"><i class="fas fa-pen"></i></button>
                        <button type="button" class="action-btn rotate-button" title="Rotate (new secret, same rights)"><i class="fas fa-sync-alt"></i></button>
                    }
                    @if (!dead && Model.GenerationStateHealthy)
                    {
                        <button type="button" class="action-btn danger revoke-button" title="Revoke"><i class="fas fa-ban"></i></button>
                    }
                </div>
            </div>
        }

        @if (Model.Tokens.Count == 0)
        {
            <div class="token-row text-secondary">No tokens yet.</div>
        }
    </div>
</div>

@* One-time secret disclosure: the full credential exists exactly here, never in a
   list. Deliberately non-dismissible by accident — static backdrop, Escape
   disabled, no header close button: a stray keypress or background click must not destroy
   a credential that cannot be recovered; the only ways out are the explicit
   Copy/Close buttons (Close still reloads via hidden.bs.modal). *@
<div class="modal fade" id="secretModal" tabindex="-1" aria-hidden="true"
     data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="secretModalTitle">Token created</h5>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning py-2 mb-3">
                    Copy the token now — it is shown <strong>only once</strong> and cannot be recovered. Store it like a password.
                </div>
                <div class="token-secret" id="secretValue"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" id="copySecretButton"><i class="fas fa-copy me-1"></i>Copy</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create token</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label" for="tokenNameInput">Name</label>
                    <input type="text" class="form-control" id="tokenNameInput" maxlength="200" placeholder="e.g. Grafana dashboard reader">
                </div>
                <div class="form-check mb-2">
                    <input type="checkbox" class="form-check-input" id="tokenReadOnlyInput">
                    <label class="form-check-label" for="tokenReadOnlyInput">Read-only</label>
                    <div class="form-text">A read-only token can read everything you can read, but every write operation is denied. Fixed at creation — changing it later means revoking and creating a new token.</div>
                </div>
                <div class="alert alert-danger py-2 modal-error" id="createModalError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn" id="createModalSave" style="background-color: #16a34a; color: #fff; border-color: #16a34a; min-width: 100px;">Create</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="renameModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Rename token</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label" for="renameInput">Name</label>
                    <input type="text" class="form-control" id="renameInput" maxlength="200">
                </div>
                <div class="alert alert-danger py-2 modal-error" id="renameModalError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="renameConfirmButton">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="rotateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Rotate token</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="rotateText">Rotate this token?</p>
                <p class="text-secondary">The current token is revoked immediately and a new secret is issued. The name and the read-only flag carry over; nothing else changes.</p>
                <div class="alert alert-danger py-2 modal-error" id="rotateModalError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" id="rotateConfirmButton">Rotate</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="revokeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Revoke token</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="revokeText">Revoke this token?</p>
                <p class="text-secondary">Applications using it stop authenticating immediately. This cannot be undone.</p>
                <div class="mb-3">
                    <label class="form-label" for="revokeReasonInput">Reason <span class="text-secondary fw-normal">(optional)</span></label>
                    <input type="text" class="form-control" id="revokeReasonInput" maxlength="256" placeholder="e.g. leaked in a CI log">
                </div>
                <div class="alert alert-danger py-2 modal-error" id="revokeModalError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="revokeConfirmButton">Revoke</button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

<script>
    'use strict';

    // ---- shared state -------------------------------------------------------

    var renameEntityId = null;
    var rotateEntityId = null;
    var revokeEntityId = null;

    function antiForgeryToken() {
        var input = document.querySelector("input[name='__RequestVerificationToken']");
        return input ? input.value : '';
    }

    function showModal(id) { bootstrap.Modal.getOrCreateInstance(document.getElementById(id)).show(); }
    function hideModal(id) { bootstrap.Modal.getInstance(document.getElementById(id))?.hide(); }

    function showError(elementId, message) {
        var el = document.getElementById(elementId);
        el.textContent = message;
        el.style.display = message ? 'block' : 'none';
    }

    // ---- timestamps ---------------------------------------------------------

    document.querySelectorAll('[data-timestamp]').forEach(function (cell) {
        var raw = cell.getAttribute('data-timestamp');
        if (!raw) return;

        // One malformed cell must never abort this script block: every handler
        // registration below depends on this loop completing.
        var ms = parseInt(raw, 10);
        if (isNaN(ms)) return;

        var date = new Date(ms);
        cell.textContent = date.toLocaleDateString() + ' ' + date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        cell.title = date.toISOString();
    });

    // ---- mutations -------------------------------------------------------------

    function postMutation(url, payload) {
        return fetch(url, {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': antiForgeryToken()
            },
            body: JSON.stringify(payload)
        })
            .then(function (response) { return response.json(); })
            .catch(function () { return { ok: false, error: 'network', message: 'The request failed.' }; });
    }

    document.getElementById('createTokenButton')?.addEventListener('click', function () {
        document.getElementById('tokenNameInput').value = '';
        document.getElementById('tokenReadOnlyInput').checked = false;
        showError('createModalError', null);
        showModal('createModal');
    });

    document.getElementById('createModalSave').addEventListener('click', function () {
        var saveButton = this;
        showError('createModalError', null);

        // In-flight guard: create is not safely repeatable client-side (a double
        // click mints two tokens); re-enabled on every failure branch — success hands
        // off to the secret modal.
        saveButton.disabled = true;

        postMutation(createTokenUrl, {
            name: document.getElementById('tokenNameInput').value.trim(),
            readOnly: document.getElementById('tokenReadOnlyInput').checked
        }).then(function (answer) {
            if (answer.ok) {
                chainToSecret('createModal', answer.token, 'Token created');
            } else {
                saveButton.disabled = false;
                showError('createModalError', answer.message || 'Creation failed.');
            }
        });
    });

    document.querySelectorAll('.rename-button').forEach(function (button) {
        button.addEventListener('click', function () {
            var row = button.closest('.token-row');
            renameEntityId = row.getAttribute('data-entity-id');
            document.getElementById('renameInput').value = row.getAttribute('data-name') || '';
            showError('renameModalError', null);
            showModal('renameModal');
        });
    });

    document.getElementById('renameConfirmButton').addEventListener('click', function () {
        showError('renameModalError', null);

        postMutation(renameTokenUrl, {
            entityId: renameEntityId,
            name: document.getElementById('renameInput').value.trim()
        }).then(function (answer) {
            if (answer.ok) {
                hideModal('renameModal');
                window.location.reload();
            } else {
                showError('renameModalError', answer.message || 'Renaming failed.');
            }
        });
    });

    // ---- one-time secret ---------------------------------------------------------

    function showSecret(token, title) {
        document.getElementById('secretModalTitle').textContent = title || 'Token created';
        document.getElementById('secretValue').textContent = token;
        showModal('secretModal');
    }

    // Shows the secret modal only after the source modal finished hiding: Bootstrap
    // restores modal-open/scroll compensation on the hide TRANSITION, and a
    // synchronous show-while-hiding loses the body scroll lock. If the source modal is
    // ALREADY hidden (the user dismissed it while the request was in flight — hide()
    // fires no event then), show immediately: the one-time secret must never be
    // dropped on the floor.
    function chainToSecret(fromModalId, token, title) {
        var element = document.getElementById(fromModalId);

        if (!element.classList.contains('show')) {
            showSecret(token, title);
            return;
        }

        element.addEventListener('hidden.bs.modal', function () {
            showSecret(token, title);
        }, { once: true });

        hideModal(fromModalId);
    }

    document.getElementById('copySecretButton').addEventListener('click', function () {
        var value = document.getElementById('secretValue').textContent;
        if (navigator.clipboard) {
            navigator.clipboard.writeText(value);
        }
        this.textContent = 'Copied';
        var self = this;
        setTimeout(function () { self.innerHTML = '<i class="fas fa-copy me-1"></i>Copy'; }, 1500);
    });

    document.getElementById('secretModal').addEventListener('hidden.bs.modal', function () {
        window.location.reload();
    });

    // ---- rotate ---------------------------------------------------------------------

    document.querySelectorAll('.rotate-button').forEach(function (button) {
        button.addEventListener('click', function () {
            var row = button.closest('.token-row');
            rotateEntityId = row.getAttribute('data-entity-id');
            document.getElementById('rotateText').textContent = 'Rotate "' + (row.getAttribute('data-name') || 'token') + '"?';
            showError('rotateModalError', null);
            showModal('rotateModal');
        });
    });

    document.getElementById('rotateConfirmButton').addEventListener('click', function () {
        var confirmButton = this;
        showError('rotateModalError', null);

        // In-flight guard: a double click rotates twice and the first replacement
        // secret is lost; the failure branch re-enables, success reloads via the
        // secret modal.
        confirmButton.disabled = true;

        postMutation(rotateTokenUrl, {
            entityId: rotateEntityId
        }).then(function (answer) {
            if (answer.ok) {
                chainToSecret('rotateModal', answer.token, 'Token rotated');
            } else {
                confirmButton.disabled = false;
                showError('rotateModalError', answer.message || 'Rotation failed.');
            }
        });
    });

    // ---- revoke -----------------------------------------------------------------------

    document.querySelectorAll('.revoke-button').forEach(function (button) {
        button.addEventListener('click', function () {
            var row = button.closest('.token-row');
            revokeEntityId = row.getAttribute('data-entity-id');
            document.getElementById('revokeText').textContent = 'Revoke "' + (row.getAttribute('data-name') || 'token') + '"?';
            document.getElementById('revokeReasonInput').value = '';
            showError('revokeModalError', null);
            showModal('revokeModal');
        });
    });

    document.getElementById('revokeConfirmButton').addEventListener('click', function () {
        showError('revokeModalError', null);

        // Deliberately no in-flight guard, unlike create/rotate: revocation is
        // idempotent server-side, so a double submit cannot mint or destroy anything.

        postMutation(revokeTokenUrl, {
            entityId: revokeEntityId,
            reason: document.getElementById('revokeReasonInput').value.trim()
        }).then(function (answer) {
            if (answer.ok) {
                hideModal('revokeModal');
                window.location.reload();
            } else {
                showError('revokeModalError', answer.message || 'Revocation failed.');
            }
        });
    });
</script>
