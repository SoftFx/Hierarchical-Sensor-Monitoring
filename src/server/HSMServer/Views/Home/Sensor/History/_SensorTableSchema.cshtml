@model HSMServer.Model.TreeViewModel.SensorNodeViewModel

@* A table sensor (ADR-0021, #1844): its data is rows stored as blocks, not values. The page shows its schema here
   and its rows below it (_SensorTableChart, #1847). *@

<div class="mt-3">
    <h6>Table schema</h6>
    <p class="text-muted small mb-2">
        A table sensor: its data is rows, sent in blocks. Schema id <code>0x@(Model.TableSchemaId.ToString("X8"))</code>.
        It has no values, statuses or alerts; it cannot be moved or renamed.
    </p>
    <table class="table table-sm w-auto">
        <thead>
            <tr>
                <th>#</th>
                <th>Column</th>
                <th>Type</th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < Model.TableColumns.Count; i++)
            {
                <tr>
                    <td>@i</td>
                    <td>@Model.TableColumns[i].Name</td>
                    <td>@Model.TableColumns[i].Type</td>
                </tr>
            }
        </tbody>
    </table>
</div>
