@using HSMServer.Extensions
@using HSMServer.Model.FileSensors

@model FileValuesPageViewModel

@*
    One page of the file values of a File sensor (#1886), newest first. Nothing a client sent (a name, an extension, a
    comment) goes into a script or an event attribute: it is HTML-encoded into text and data-* attributes, and the
    handlers in _SensorFileContent read the attributes. Element ids are made of the value's time only.
*@

@foreach (var row in Model.Rows)
{
    <div class='accordion my-1 file-row' id='@row.RowId' data-time='@row.TimeTicks' data-extension='@row.Extension'
         data-preview='@(row.IsPreviewEnabled ? "true" : "false")'>
        <div class='accordion-item'>
            <h2 class='accordion-header'>
                <button class='accordion-button collapsed pt-2 pb-1 file-row-toggle' type='button' data-bs-toggle='collapse'
                        data-bs-target='#@(row.RowId)_collapse' aria-expanded='false' aria-controls='@(row.RowId)_collapse'>
                    <div class="w-100">
                        <div class='row justify-content-between'>
                            <div class='row col-md-auto align-items-center align-self-baseline'>
                                <div class='col-md-auto sensor-icon-without-padding'>
                                    <li class='@row.Status.ToClient().ToIcon() sensor-icon-with-margin' title='Status: @row.Status'></li>
                                    <span class="file-row-name">@row.Name</span>
                                    <div class="d-flex text-break pt-2">
                                        @if (!string.IsNullOrEmpty(row.Comment))
                                        {
                                            <span class="d-flex text-break">Comment: @row.Comment</span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class='col-md-auto time-ago-div me-3 align-self-end'>
                                <div class="d-flex flex-md-column align-items-end" style="font-size: smaller">
                                    <span>Size: @row.Size</span>
                                    <span>@row.Time.ToDefaultFormat()</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </button>
            </h2>
            <div id='@(row.RowId)_collapse' class='accordion-collapse collapse text-break'>
                <div class='accordion-body p-3'>
                    <div class="row">
                        <div class="d-flex col-6">
                            <div class="align-self-center text-end">
                                @if (row.IsPreviewEnabled)
                                {
                                    <h5 class="mb-0">Content:</h5>
                                }
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="row justify-content-end">
                                <div class="d-flex flex-row-reverse">
                                    <a class='btn btn-outline-secondary d-flex justify-content-center align-items-center button-width-static ms-1 file-row-download' title='Download'>
                                        <i class='fas fa-file-download small-icon pe-1'></i>
                                        <span style="font-size: smaller">Download</span>
                                    </a>
                                    <a class='btn btn-outline-secondary d-flex justify-content-center align-items-center button-width-static me-1 file-row-view' title='Preview'>
                                        <i class='fas fa-eye small-icon pe-1'></i>
                                        <span style="font-size: smaller"> Preview</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="d-grid d-none pt-3" id="preview_@row.RowId">
                        <div style="overflow-x: auto" id="preview-content_@row.RowId"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (Model.OlderThanTicks is { } olderThan)
{
    <div class="d-flex justify-content-center my-2 file-page-more">
        <button type="button" class="btn btn-outline-secondary btn-sm file-page-older" data-older='@olderThan'>Older files</button>
    </div>
}
