@using HSMServer.Extensions
@using HSMServer.Model.FileSensors

@model LargeFileDownloadsViewModel

@* Who downloaded one large file (#1886), from the download log (#1885); every name is HTML-encoded text. *@

@if (Model.IsUnavailable)
{
    <div class="text-muted large-file-downloads-unavailable">The download log cannot be read now. Try again later.</div>
}
else if (Model.Downloads.Count == 0)
{
    <div class="text-muted">Nobody has downloaded this file.</div>
}
else
{
    @foreach (var download in Model.Downloads)
    {
        <div class="large-file-download">@download.TimeUtc.ToDefaultFormat() · @download.Who · @download.Channel</div>
    }

    @if (Model.IsCut)
    {
        <div class="text-muted">The most recent @Model.Downloads.Count downloads.</div>
    }
}
