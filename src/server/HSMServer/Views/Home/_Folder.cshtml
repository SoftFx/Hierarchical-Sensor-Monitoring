@using HSMServer.Model.Folders
@using HSMServer.Model.Folders.ViewModels
@using HSMServer.Model.Authentication

@model FolderModel

@inject HSMServer.Model.TreeViewModel.UserTreeAccess TreeAccess

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers


@await Html.PartialAsync("_MetaInfo", new FolderInfoViewModel(Model, TreeAccess.GetVisibleProducts(User as User, Model).Values))

@await Html.PartialAsync("_ChildrenPanel", (User as User).SelectedNode)
