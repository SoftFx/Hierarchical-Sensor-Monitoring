# The server image's HEALTHCHECK (docker_scripts/HSMserver/Dockerfile.healthcheck, #1465) probes the
# Sensor API with `wget`, so wget below is not only a build-time helper: keep it in the final image.
# The publishing lane fails if it disappears ("Verify the image declares a HEALTHCHECK").
FROM mcr.microsoft.com/dotnet/aspnet:8.0

RUN apt-get update && \
    apt-get install -y \
        wget \
        apt-transport-https \
        procps \
    && wget https://packages.microsoft.com/config/debian/$(cat /etc/debian_version | cut -d'.' -f1)/packages-microsoft-prod.deb -O packages-microsoft-prod.deb \
    && dpkg -i packages-microsoft-prod.deb \
    && rm packages-microsoft-prod.deb \
    && apt-get update \
    && apt-get install -y procdump \
    && rm -rf /var/lib/apt/lists/*
