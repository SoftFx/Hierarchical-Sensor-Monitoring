# HSM collector conformance — full SensorOptions registration surface + path model (#1098 §6).
# create_int_sensor_full_options|path|ttl_ms|unit|keep_history_ms|self_destroy_ms|statistics|
#     is_singleton|aggregate|grafana|is_computer|sensor_location|description[|default_alert_options]
#   tri-state (is_singleton/aggregate/grafana): -1 => null, 0 => false, 1 => true
#   statistics: -1 => null, else StatisticsOptions flags (EMA=1)
#   is_computer: true => path anchors at ComputerName node AND forces IsSingletonSensor=true
#   sensor_location: 0 => Module (ComputerName/Module/Path), 1 => Product (bare Path)
#   default_alert_options (optional trailing field, absent => 0): managed [Flags] DefaultAlertsOptions
#     bitmask — DisableTtl=1, DisableStatusChange=2. The server auto-attaches a default TTL +
#     status-change alert to every new sensor; these flags register them disabled.
# Ticks on the wire = ms * 10000 (KeepHistory/SelfDestroy).

full_options_register_in_payload|create_collector
full_options_register_in_payload|create_int_sensor_full_options|contract/opts/full|60000|3|600000|1200000|1|1|1|1|false|0|opts
full_options_register_in_payload|start
full_options_register_in_payload|stop
full_options_register_in_payload|expect_registration_count|1
full_options_register_in_payload|expect_registration_contains|0|"TTLTicks":[600000000]
full_options_register_in_payload|expect_registration_contains|0|"OriginalUnit":3,
full_options_register_in_payload|expect_registration_contains|0|"KeepHistory":6000000000
full_options_register_in_payload|expect_registration_contains|0|"SelfDestroy":12000000000
full_options_register_in_payload|expect_registration_contains|0|"Statistics":1
full_options_register_in_payload|expect_registration_contains|0|"IsSingletonSensor":true
full_options_register_in_payload|expect_registration_contains|0|"AggregateData":true
full_options_register_in_payload|expect_registration_contains|0|"EnableGrafana":true
full_options_register_in_payload|expect_registration_contains|0|"Path":"conformance-host/conformance-module/contract/opts/full"

computer_sensor_anchors_at_computer_node|create_collector
computer_sensor_anchors_at_computer_node|create_int_sensor_full_options|contract/opts/computer|0|-1|0|0|1|-1|-1|-1|true|0|c
computer_sensor_anchors_at_computer_node|start
computer_sensor_anchors_at_computer_node|stop
computer_sensor_anchors_at_computer_node|expect_registration_count|1
computer_sensor_anchors_at_computer_node|expect_registration_contains|0|"Path":"conformance-host/contract/opts/computer"
computer_sensor_anchors_at_computer_node|expect_registration_contains|0|"IsSingletonSensor":true

product_sensor_anchors_at_root|create_collector
product_sensor_anchors_at_root|create_int_sensor_full_options|contract/opts/product|0|-1|0|0|1|-1|-1|-1|false|1|p
product_sensor_anchors_at_root|start
product_sensor_anchors_at_root|stop
product_sensor_anchors_at_root|expect_registration_count|1
product_sensor_anchors_at_root|expect_registration_contains|0|"Path":"contract/opts/product"
product_sensor_anchors_at_root|expect_registration_contains|0|"IsSingletonSensor":null

# DefaultAlertsOptions: absent trailing field => 0 (None); the server attaches its default alerts.
default_alerts_none|create_collector
default_alerts_none|create_int_sensor_full_options|contract/opts/da_none|0|-1|0|0|-1|-1|-1|-1|false|0|d
default_alerts_none|start
default_alerts_none|stop
default_alerts_none|expect_registration_count|1
default_alerts_none|expect_registration_contains|0|"DefaultAlertsOptions":0}

# DisableTtl=1 registers the default TTL inactivity alert disabled.
default_alerts_disable_ttl|create_collector
default_alerts_disable_ttl|create_int_sensor_full_options|contract/opts/da_ttl|0|-1|0|0|-1|-1|-1|-1|false|0|d|1
default_alerts_disable_ttl|start
default_alerts_disable_ttl|stop
default_alerts_disable_ttl|expect_registration_count|1
default_alerts_disable_ttl|expect_registration_contains|0|"DefaultAlertsOptions":1}

# DisableStatusChange=2 registers the default status-change notification disabled.
default_alerts_disable_status_change|create_collector
default_alerts_disable_status_change|create_int_sensor_full_options|contract/opts/da_status|0|-1|0|0|-1|-1|-1|-1|false|0|d|2
default_alerts_disable_status_change|start
default_alerts_disable_status_change|stop
default_alerts_disable_status_change|expect_registration_count|1
default_alerts_disable_status_change|expect_registration_contains|0|"DefaultAlertsOptions":2}

# DisableTtl | DisableStatusChange = 3 registers both defaults disabled.
default_alerts_disable_both|create_collector
default_alerts_disable_both|create_int_sensor_full_options|contract/opts/da_both|0|-1|0|0|-1|-1|-1|-1|false|0|d|3
default_alerts_disable_both|start
default_alerts_disable_both|stop
default_alerts_disable_both|expect_registration_count|1
default_alerts_disable_both|expect_registration_contains|0|"DefaultAlertsOptions":3}

# create_enum_sensor_full_options|path|ttl_ms|keep_history_ms|aggregate|grafana|is_computer|
#     description|key:value:color:desc[;...]
# An enum sensor carrying its EnumOptions AND the SensorOptions surface in one registration —
# managed CreateEnumSensor(path, new EnumSensorOptions { ... }), native
# hsm_collector_create_enum_sensor_with_sensor_options (0.9.0). Consumes staged alerts.
enum_full_options_register_in_payload|create_collector
enum_full_options_register_in_payload|create_enum_sensor_full_options|contract/opts/enum_full|60000|600000|1|0|true|svc|0:Stopped:16711680:stopped;4:Running:65280:running
enum_full_options_register_in_payload|start
enum_full_options_register_in_payload|stop
enum_full_options_register_in_payload|expect_registration_count|1
enum_full_options_register_in_payload|expect_registration_contains|0|"Path":"conformance-host/contract/opts/enum_full"
enum_full_options_register_in_payload|expect_registration_contains|0|"SensorType":10,
enum_full_options_register_in_payload|expect_registration_contains|0|"TTLTicks":[600000000]
enum_full_options_register_in_payload|expect_registration_contains|0|"Description":"svc"
enum_full_options_register_in_payload|expect_registration_contains|0|"EnumOptions":[{"Key":0,"Value":"Stopped","Color":16711680,"Description":"stopped"},{"Key":4,"Value":"Running","Color":65280,"Description":"running"}]
enum_full_options_register_in_payload|expect_registration_contains|0|"KeepHistory":6000000000
enum_full_options_register_in_payload|expect_registration_contains|0|"DisplayUnit":null
enum_full_options_register_in_payload|expect_registration_contains|0|"IsSingletonSensor":true
enum_full_options_register_in_payload|expect_registration_contains|0|"AggregateData":true
enum_full_options_register_in_payload|expect_registration_contains|0|"EnableGrafana":false

# The ServiceStatusPrototype shape a state source registers: aggregated enum + "value != Running
# for 5 min" alert (Value NotEqual Const 4, 5-min confirmation), module-anchored, no TTL.
enum_full_options_with_state_alert|create_collector
enum_full_options_with_state_alert|alert_new|instant
enum_full_options_with_state_alert|alert_condition|0|20|5|0|4
enum_full_options_with_state_alert|alert_confirmation|300000
enum_full_options_with_state_alert|alert_notification|not running|3
enum_full_options_with_state_alert|alert_stage
enum_full_options_with_state_alert|create_enum_sensor_full_options|contract/opts/enum_alert|0|0|1|-1|false|s|0:Stopped:16711680:stopped;4:Running:65280:running
enum_full_options_with_state_alert|start
enum_full_options_with_state_alert|stop
enum_full_options_with_state_alert|expect_registration_count|1
enum_full_options_with_state_alert|expect_registration_contains|0|"Path":"conformance-host/conformance-module/contract/opts/enum_alert"
enum_full_options_with_state_alert|expect_registration_contains|0|"TTLTicks":null
enum_full_options_with_state_alert|expect_registration_contains|0|"AggregateData":true
enum_full_options_with_state_alert|expect_registration_contains|0|"EnableGrafana":null
enum_full_options_with_state_alert|expect_registration_contains|0|"Alerts":[{"Conditions":[{"Combination":0,"Operation":5,"Property":20,"Target":{"Type":0,"Value":"4"}}],"Status":1,"DestinationMode":3,"Template":"not running","Icon":null,"IsDisabled":false,"ConfirmationPeriod":3000000000,"ScheduledNotificationTime":null,"ScheduledRepeatMode":null,"ScheduledInstantSend":null}]
