# HSM collector conformance v1 — sensor registration (AddOrUpdateSensorRequest) contract.
# New verbs:
# create_int_sensor_with_options|path|ttl_ms|unit|description   (ttl_ms=0 => no TTL; unit=-1 => unset; unit codes per HSMSensorDataObjects Unit enum)
# create_enum_sensor_with_options|path|description|key:value:color:desc[;key:value:color:desc...]
# expect_registration_count|count|[timeout_s]                    (polls like expect_sent_count)
# expect_registration_contains|index|substring                   (canonical registration text)
# Canonical registration text (portable subset; fixed order):
# {"Command":"AddOrUpdate","Path":"...","SensorType":N,"TTLTicks":[t|null,...]|null,
#  "OriginalUnit":N|null,"Description":"..."|null,"EnumOptions":[{"Key":k,"Value":"v","Color":c,"Description":"d"},...]|null}
# Contract notes:
# - Every sensor registers itself when the collector starts (one AddOrUpdate per sensor);
#   a sensor created while the collector is running registers immediately.
# - TTLTicks are .NET ticks (ttl_ms * 10000).
# - The registration Path is the FULL sensor path including the collector identity prefix
#   (computer/module) — anchor path asserts with a trailing quote, not a leading one.
# - Alerts/TtlAlerts ARE part of the canonical text now (see alert_registration_contract.hsmtest);
#   other managed-only registration flags remain language-local. The exact wire bytes are pinned by
#   the paired golden unit tests (WireFormatGoldenLockTests / native NativeWireRegistration*).

plain_int_sensor_registers_on_start|create_collector
plain_int_sensor_registers_on_start|create_int_sensor|contract/registration/basic
plain_int_sensor_registers_on_start|start
plain_int_sensor_registers_on_start|stop
plain_int_sensor_registers_on_start|expect_registration_count|1
plain_int_sensor_registers_on_start|expect_registration_contains|0|contract/registration/basic"
plain_int_sensor_registers_on_start|expect_registration_contains|0|"SensorType":1,
plain_int_sensor_registers_on_start|expect_registration_contains|0|"TTLTicks":null
plain_int_sensor_registers_on_start|expect_registration_contains|0|"OriginalUnit":null

int_sensor_registers_ttl_unit_description|create_collector
int_sensor_registers_ttl_unit_description|create_int_sensor_with_options|contract/registration/options|60000|1|queue depth
int_sensor_registers_ttl_unit_description|start
int_sensor_registers_ttl_unit_description|stop
int_sensor_registers_ttl_unit_description|expect_registration_count|1
int_sensor_registers_ttl_unit_description|expect_registration_contains|0|"TTLTicks":[600000000]
int_sensor_registers_ttl_unit_description|expect_registration_contains|0|"OriginalUnit":1,
int_sensor_registers_ttl_unit_description|expect_registration_contains|0|"Description":"queue depth"

enum_sensor_registers_enum_options|create_collector
enum_sensor_registers_enum_options|create_enum_sensor_with_options|contract/registration/enum|states|0:Idle:65280:nothing to do;1:Busy:16711680:working hard
enum_sensor_registers_enum_options|start
enum_sensor_registers_enum_options|stop
enum_sensor_registers_enum_options|expect_registration_count|1
enum_sensor_registers_enum_options|expect_registration_contains|0|"SensorType":10,
enum_sensor_registers_enum_options|expect_registration_contains|0|"EnumOptions":[{"Key":0,"Value":"Idle","Color":65280,"Description":"nothing to do"},{"Key":1,"Value":"Busy","Color":16711680,"Description":"working hard"}]
enum_sensor_registers_enum_options|expect_registration_contains|0|"Description":"states"

each_sensor_registers_once|create_collector
each_sensor_registers_once|create_int_sensor|contract/registration/multi/a
each_sensor_registers_once|create_double_sensor|contract/registration/multi/b
each_sensor_registers_once|create_string_sensor|contract/registration/multi/c
each_sensor_registers_once|start
each_sensor_registers_once|stop
each_sensor_registers_once|expect_registration_count|3

sensor_created_while_running_registers|create_collector
sensor_created_while_running_registers|start
sensor_created_while_running_registers|create_int_sensor|contract/registration/dynamic
sensor_created_while_running_registers|expect_registration_count|1|5
sensor_created_while_running_registers|stop

restart_reregisters_sensor|create_collector
restart_reregisters_sensor|create_int_sensor|contract/registration/restart
restart_reregisters_sensor|start
restart_reregisters_sensor|stop
restart_reregisters_sensor|expect_registration_count|1
restart_reregisters_sensor|start
restart_reregisters_sensor|stop
restart_reregisters_sensor|expect_registration_count|2

# Default Statistics/DisplayUnit/OriginalUnit per kind — the managed collector NEVER emits
# Statistics:null (non-nullable StatisticsOptions, default None=0). DisplayUnit is 0 for typed-instant
# kinds and null for enum/bar (their EnumSensorOptions/BarSensorOptions ToApi emit null). Rate
# defaults OriginalUnit to ValueInSecond(3000). Locks native against the real collector cross-language.
default_fields_int_sensor|create_collector
default_fields_int_sensor|create_int_sensor|contract/registration/defaults/int
default_fields_int_sensor|start
default_fields_int_sensor|stop
default_fields_int_sensor|expect_registration_contains|0|"Statistics":0
default_fields_int_sensor|expect_registration_contains|0|"DisplayUnit":0

default_fields_enum_sensor|create_collector
default_fields_enum_sensor|create_enum_sensor|contract/registration/defaults/enum
default_fields_enum_sensor|start
default_fields_enum_sensor|stop
default_fields_enum_sensor|expect_registration_contains|0|"Statistics":0
default_fields_enum_sensor|expect_registration_contains|0|"DisplayUnit":null

default_fields_bar_sensor|create_collector
default_fields_bar_sensor|create_int_bar_sensor|contract/registration/defaults/bar|1000|0
default_fields_bar_sensor|start
default_fields_bar_sensor|stop
default_fields_bar_sensor|expect_registration_contains|0|"Statistics":0
default_fields_bar_sensor|expect_registration_contains|0|"DisplayUnit":null

default_fields_rate_sensor|create_collector
default_fields_rate_sensor|create_rate_sensor|contract/registration/defaults/rate|100
default_fields_rate_sensor|start
default_fields_rate_sensor|stop
default_fields_rate_sensor|expect_registration_contains|0|"Statistics":0
default_fields_rate_sensor|expect_registration_contains|0|"DisplayUnit":0
default_fields_rate_sensor|expect_registration_contains|0|"OriginalUnit":3000

# Changing a created sensor's description (#1482; native hsm_sensor_set_description 0.10.0, managed
# IDescribableSensor.SetDescription):
# set_sensor_description|sensor_index|description   (flat creation index, like dispose_sensor)
# - before Start the new text is what Start registers (one registration, no extra one);
# - while running the sensor is re-registered with the new text and its other options kept. How that
#   is recorded differs by design: native replaces the run's recorded registration in place, managed
#   records the re-sent AddOrUpdate as a new entry — so these cases address the latest registration
#   with index -1 and never pin the count after a change made while running;
# - while stopped nothing is sent; the next Start registers the new text;
# - token:null sends "Description":null (the server keeps what it has).
set_description_before_start_rides_start_registration|create_collector
set_description_before_start_rides_start_registration|create_int_sensor_with_options|contract/registration/describe/before|60000|1|first
set_description_before_start_rides_start_registration|set_sensor_description|0|second
set_description_before_start_rides_start_registration|start
set_description_before_start_rides_start_registration|stop
set_description_before_start_rides_start_registration|expect_registration_count|1
set_description_before_start_rides_start_registration|expect_registration_contains|0|"Description":"second"
set_description_before_start_rides_start_registration|expect_registration_contains|0|"TTLTicks":[600000000]

set_description_while_running_reregisters|create_collector
set_description_while_running_reregisters|create_int_sensor_with_options|contract/registration/describe/running|60000|1|first
set_description_while_running_reregisters|start
set_description_while_running_reregisters|expect_registration_count|1
set_description_while_running_reregisters|set_sensor_description|0|limit 2048 MB
set_description_while_running_reregisters|stop
set_description_while_running_reregisters|expect_registration_contains|-1|contract/registration/describe/running"
set_description_while_running_reregisters|expect_registration_contains|-1|"Description":"limit 2048 MB"
set_description_while_running_reregisters|expect_registration_contains|-1|"TTLTicks":[600000000]
set_description_while_running_reregisters|expect_registration_contains|-1|"OriginalUnit":1,

set_description_while_stopped_waits_for_next_start|create_collector
set_description_while_stopped_waits_for_next_start|create_int_sensor_with_options|contract/registration/describe/stopped|0|-1|first
set_description_while_stopped_waits_for_next_start|start
set_description_while_stopped_waits_for_next_start|stop
set_description_while_stopped_waits_for_next_start|set_sensor_description|0|second
set_description_while_stopped_waits_for_next_start|expect_registration_count|1
set_description_while_stopped_waits_for_next_start|expect_registration_contains|0|"Description":"first"
set_description_while_stopped_waits_for_next_start|start
set_description_while_stopped_waits_for_next_start|stop
set_description_while_stopped_waits_for_next_start|expect_registration_count|2
set_description_while_stopped_waits_for_next_start|expect_registration_contains|1|"Description":"second"

set_description_null_is_sent_as_null|create_collector
set_description_null_is_sent_as_null|create_int_sensor_with_options|contract/registration/describe/null|0|-1|first
set_description_null_is_sent_as_null|set_sensor_description|0|token:null
set_description_null_is_sent_as_null|start
set_description_null_is_sent_as_null|stop
set_description_null_is_sent_as_null|expect_registration_contains|0|"Description":null

set_description_applies_to_a_bar_sensor|create_collector
set_description_applies_to_a_bar_sensor|create_int_bar_sensor|contract/registration/describe/bar|1000|0
set_description_applies_to_a_bar_sensor|set_sensor_description|0|bar text
set_description_applies_to_a_bar_sensor|start
