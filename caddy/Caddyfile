{
	# HTTP/3 would be advertised (Alt-Svc) on UDP ports that are not published.
	persist_config off
	servers {
		protocols h1 h2
	}
	# Clients that reach this host by IP (no SNI) or by another name get the
	# HSM_DOMAIN certificate instead of a refused handshake.
	default_sni {$HSM_DOMAIN}
	fallback_sni {$HSM_DOMAIN}
}

# Exactly one certificate source is selected by the entrypoint. There is deliberately no
# automatic fallback: a failed public-certificate renewal must not silently change trust.
(tls-letsencrypt-http) {
	tls {
		issuer acme
	}
}
(tls-dns-cloudflare) {
	tls {
		issuer acme {
			dns cloudflare {env.CF_API_TOKEN}
		}
	}
}
(tls-dns-dynv6) {
	tls {
		issuer acme {
			dns dynv6 {env.DYNV6_API_TOKEN}
		}
	}
}
(tls-self-signed) {
	tls internal
}
(tls-custom) {
	tls /certs/cert.pem /certs/key.pem
}
(hsm_upstream) {
	transport http {
		tls_insecure_skip_verify
	}
	# Caddy >= 2.11 replaces the Host header with the upstream address ("app:443"),
	# which only Docker's DNS resolves; HSM builds absolute redirects (login) from the
	# request Host, so browsers would be sent to an unreachable name. Pass the
	# client-visible Host through.
	header_up Host {hostport}
	# Wait for HSM while it starts (database load) instead of answering 502.
	lb_try_duration 30s
}

# VictoriaLogs read-only exposure (docker-compose 'logs' profile). VictoriaLogs runs with
# -http.pathPrefix=/logs, so its built-in web UI (/logs/select/vmui) and the LogSQL query
# API (/logs/select/logsql) map 1:1 under that prefix. Only /logs/select/* is routed, and
# only for a logged-in HSM admin: forward_auth consults the app's session-check endpoint
# (204 admits; the endpoint's login-redirect/401/403 answers are passed back to the client
# as-is). Ingest (/logs/insert/...), /logs/delete/* and the internal endpoints are NOT
# routed here — shipping is done by vlagent inside the compose network.
(victorialogs-routes) {
	@victorialogs path /logs/select/*
	handle @victorialogs {
		forward_auth https://app:443 {
			uri /logs-auth
			import hsm_upstream
		}
		reverse_proxy victorialogs:9428
	}
}

# The primary address (#1590): one port, 443, serving the Web UI and the Sensor API
# through the app's single listener.
{$HSM_DOMAIN} {
	import {$HSM_TLS_SNIPPET}
	import victorialogs-routes
	handle {
		reverse_proxy https://app:443 {
			import hsm_upstream
		}
	}
}

# Deprecated legacy ports (#1590): kept answering through the deprecation window so
# clients still pointed at the old two-port scheme keep working. Both forward to the SAME
# single upstream as the primary address — the app has no second listener anymore. A
# request through them carries its legacy port in the Host header, which the app logs as
# a rate-limited deprecation warning. These blocks (and their ports: entries in
# docker-compose.yml) are removed in the follow-up release that closes the window.
{$HSM_DOMAIN}:44333 {
	import {$HSM_TLS_SNIPPET}
	import victorialogs-routes
	handle {
		reverse_proxy https://app:443 {
			import hsm_upstream
		}
	}
}
{$HSM_DOMAIN}:44330 {
	import {$HSM_TLS_SNIPPET}
	handle {
		reverse_proxy https://app:443 {
			import hsm_upstream
		}
	}
}

# Preserve connections made by IP, short name, or an old CNAME. These clients receive the
# HSM_DOMAIN certificate and may need "allow untrusted certificate" for a name mismatch.
https://:443, https://:44333, https://:44330 {
	import victorialogs-routes
	handle {
		reverse_proxy https://app:443 {
			import hsm_upstream
		}
	}
}
